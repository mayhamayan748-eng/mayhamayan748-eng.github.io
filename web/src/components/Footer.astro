---
import Icon from './Icon.astro';
import { type Locale, pick, useT } from '@/i18n/ui';
import { profile, links } from '@/data/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useT(locale);
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-4 px-4 py-10 text-sm text-muted sm:flex-row sm:items-center sm:px-6">
    <p>© {year} {pick(profile.name, locale)}. {t('footer.built')}</p>
    <ul class="flex items-center gap-3">
      {links.map((l) => (
        <li>
          <a href={l.href} target={l.icon === 'mail' ? undefined : '_blank'} rel="noopener noreferrer" aria-label={l.label} class="grid size-9 place-items-center rounded-md transition-colors hover:text-gold">
            <Icon name={l.icon} class="size-4.5" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
