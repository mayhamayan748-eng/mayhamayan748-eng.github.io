---
import Icon from './Icon.astro';
import { type Locale, localePath, otherLocale, pick, useT } from '@/i18n/ui';
import { profile } from '@/data/site';
import { getPosts } from '@/lib/posts';

interface Props { locale: Locale; path: string }
const { locale, path } = Astro.props;
const t = useT(locale);
const home = localePath('/', locale);
const nav = [
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#projects`, label: t('nav.projects') },
  { href: `${home}#skills`, label: t('nav.skills') },
  { href: `${home}#experience`, label: t('nav.experience') },
  { href: `${home}#contact`, label: t('nav.contact') },
];
const other = otherLocale(locale);
const hasPosts = (await getPosts(locale)).length > 0;
if (hasPosts) nav.splice(4, 0, { href: localePath('/blog', locale), label: t('nav.blog') });
---
<header class="sticky top-0 z-40 border-b border-line/60 bg-bg/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={home} class="flex items-center gap-2 font-semibold tracking-tight">
      <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}${profile.logo}`} alt="" width="40" height="36" class="logo-mark h-9 w-auto" />
      <span class="hidden sm:inline">{pick(profile.displayName, locale)}</span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-6 text-sm text-muted">
        {nav.map((n) => <li><a href={n.href} class="nav-link transition-colors hover:text-gold">{n.label}</a></li>)}
        <li><a href={localePath('/cv', locale)} class="transition-colors hover:text-gold">{t('nav.cv')}</a></li>
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <a
        href={localePath(path, other)}
        hreflang={other}
        lang={other}
        class="inline-flex h-9 items-center gap-1.5 rounded-md px-2.5 text-sm text-muted transition-colors hover:text-gold"
      ><Icon name="globe" class="size-4" />{t('lang.switch')}</a>
      <button
        type="button"
        id="theme-toggle"
        class="grid size-9 place-items-center rounded-md text-muted transition-colors hover:text-gold"
        aria-label={t('theme.toggle')}
        title={t('theme.toggle')}
      >
        <span class="theme-icon-dark"><Icon name="sun" class="size-4.5" /></span>
        <span class="theme-icon-light hidden"><Icon name="moon" class="size-4.5" /></span>
      </button>
      <details class="relative md:hidden">
        <summary class="grid size-9 cursor-pointer list-none place-items-center rounded-md text-muted hover:text-gold" aria-label="Menu">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </summary>
        <ul class="absolute end-0 mt-2 w-48 rounded-lg border border-line bg-surface p-2 text-sm shadow-xl">
          {nav.map((n) => <li><a href={n.href} class="block rounded px-3 py-2 hover:bg-surface-2 hover:text-gold">{n.label}</a></li>)}
          <li><a href={localePath('/cv', locale)} class="block rounded px-3 py-2 hover:bg-surface-2 hover:text-gold">{t('nav.cv')}</a></li>
        </ul>
      </details>
    </div>
  </div>
</header>

<style>
  :global([data-theme='light']) .theme-icon-dark { display: none; }
  :global([data-theme='light']) .theme-icon-light { display: inline; }
  summary::-webkit-details-marker { display: none; }
</style>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const d = document.documentElement;
    const light = d.getAttribute('data-theme') === 'light';
    if (light) d.removeAttribute('data-theme');
    else d.setAttribute('data-theme', 'light');
    try { localStorage.setItem('theme', light ? 'dark' : 'light'); } catch {}
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', light ? '#0a0a0a' : '#faf7f0');
  });
  // Close the mobile menu after picking an anchor.
  document.querySelectorAll('header details a').forEach((a) =>
    a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')),
  );
</script>
