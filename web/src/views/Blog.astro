---
import { marked } from 'marked';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import { type Locale, localePath, useT } from '@/i18n/ui';
import { formatDate } from '@/lib/format';
import type { Post } from '@/lib/posts';

interface Props { locale: Locale; posts: Post[]; post?: Post }
const { locale, posts, post } = Astro.props;
const t = useT(locale);
// Posts are authored by me via the API, so their markdown is trusted.
const html = post ? await marked.parse(post.body_md) : '';
---
{post ? (
  <Base locale={locale} path={`/blog/${post.slug}`} title={post.title} description={post.summary}>
    <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
      <a href={localePath('/blog', locale)} class="text-sm text-muted hover:text-gold">← {t('blog.title')}</a>
      {post.published_at && <p class="mt-8 font-mono text-xs text-muted">{formatDate(post.published_at, locale)}</p>}
      <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{post.title}</h1>
      {post.cover_url && <img src={post.cover_url} alt="" class="mt-8 w-full rounded-xl border border-line" />}
      <div class="prose-post mt-10" set:html={html} />
    </article>
  </Base>
) : (
  <Base locale={locale} path="/blog" title={t('blog.title')}>
    <Section id="posts" title={t('blog.title')}>
      <ul class="grid gap-4">
        {posts.map((p) => (
          <li>
            <a href={localePath(`/blog/${p.slug}`, locale)} class="block rounded-xl border border-line bg-surface p-5 transition-colors hover:border-gold/60">
              {p.published_at && <p class="font-mono text-xs text-muted">{formatDate(p.published_at, locale)}</p>}
              <h2 class="mt-1 text-lg font-semibold">{p.title}</h2>
              <p class="mt-1 text-muted">{p.summary}</p>
            </a>
          </li>
        ))}
      </ul>
    </Section>
  </Base>
)}

<style is:global>
  .prose-post { line-height: 1.8; }
  .prose-post :where(h2, h3) { margin: 2rem 0 0.75rem; font-weight: 600; }
  .prose-post h2 { font-size: 1.5rem; }
  .prose-post h3 { font-size: 1.2rem; }
  .prose-post :where(p, ul, ol, pre, blockquote) { margin: 1rem 0; }
  .prose-post :where(ul, ol) { padding-inline-start: 1.5rem; list-style: revert; }
  .prose-post a { color: var(--gold); text-decoration: underline; }
  .prose-post code { font-family: var(--font-mono); font-size: 0.9em; background: var(--surface-2); padding: 0.1em 0.35em; border-radius: 4px; }
  .prose-post pre { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 1rem; overflow-x: auto; direction: ltr; }
  .prose-post pre code { background: none; padding: 0; }
  .prose-post blockquote { border-inline-start: 2px solid var(--gold); padding-inline-start: 1rem; color: var(--muted); }
  .prose-post img { border-radius: 10px; }
</style>
