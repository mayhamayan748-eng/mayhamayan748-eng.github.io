# Render injects DATABASE_URL automatically. Locally, SQLite works out of the box.
DATABASE_URL=sqlite:///./dev.db
# Comma-separated origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:4321,https://mayhamayan748-eng.github.io
# Email notification for contact messages (Resend). If unset, SMTP_* is tried, then a log line.
RESEND_API_KEY=
RESEND_FROM=Portfolio <onboarding@resend.dev>
NOTIFY_EMAIL=mayhamayan748@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Salt for hashing visitor IPs (never store raw IPs)
IP_HASH_SALT=change-me
CONTACT_RATE_LIMIT=5/hour
